<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SnappySnap.App">
  <StackPanel ToolTip="{Binding FileInfo}" AutomationProperties.Name="{Binding AccessibleName}">
    <Border Height="{Binding ThumbnailHeight, RelativeSource={RelativeSource AncestorType={x:Type local:ShelfContent}}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
      <Grid>
        <TextBlock Text="{Binding MediaLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
        <Border Visibility="{Binding VideoVisibility}" Width="38" Height="38" CornerRadius="19" Background="#C0191E22" BorderBrush="#CCFFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="" Foreground="#EEF0F1" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border Background="#DD191E22" CornerRadius="4" Padding="6,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5">
          <TextBlock Text="{Binding Badge}" Foreground="#EEF0F1" FontSize="10" />
        </Border>
      </Grid>
    </Border>
    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.FilePath}" Margin="0,7,0,4" FontSize="12" />
    <TextBlock Text="{Binding Metadata}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
  </StackPanel>
</DataTemplate>
